# =============================================================================
# FoodConnect — Environment Configuration Template
# =============================================================================
# NOTE: DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL.
# Copy this file to '.env.local' for local development configuration:
#   cp .env.example .env.local

# -----------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas / Local)
# -----------------------------------------------------------------------------
# Connection URI for MongoDB.
# Local development default: mongodb://localhost:27017/foodconnect
# MongoDB Atlas cluster format:
#   mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/foodconnect

# Target database name
MONGODB_DB=foodconnect

# -----------------------------------------------------------------------------
# Google Maps Platform (Visualization & Proximity)
# -----------------------------------------------------------------------------
# Public client-side API key for Google Maps Platform and geocoding.
# Leave blank or use dummy key to use built-in vector SVG fallback map for Vizag.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Google Cloud Storage / Firebase Storage (Optional Media Evidence)
# -----------------------------------------------------------------------------
# Optional bucket for distribution photo proof.
# If omitted, FoodConnect automatically uses in-memory local storage with SHA-256 digests.
# GCS_BUCKET_NAME=foodconnect-evidence-vizag
# GOOGLE_CLOUD_PROJECT=foodconnect-college-demo
# FIREBASE_STORAGE_BUCKET=foodconnect-vizag.appspot.com

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

